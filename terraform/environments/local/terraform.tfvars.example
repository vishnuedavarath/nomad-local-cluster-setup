# =============================================================================
# terraform.tfvars.example
# =============================================================================
# Copy this file to terraform.tfvars and customize for your environment.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# =============================================================================

# --------------------------------------------------------------------------- #
# VM Infrastructure
# --------------------------------------------------------------------------- #

server_count       = 3        # Must be odd (1, 3, 5) for quorum
client_count       = 3        # At least 1
server_name_prefix = "nomad-server"
client_name_prefix = "nomad-client"

# Apple Silicon (arm64):
vm_image = "https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-generic-arm64.qcow2"
# Intel (amd64):
# vm_image = "https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-generic-amd64.qcow2"
# Ubuntu (simple alias):
# vm_image = "24.04"

server_cpus   = 1
server_memory = "1G"
server_disk   = "5G"

client_cpus   = 1
client_memory = "2G"
client_disk   = "10G"

# --------------------------------------------------------------------------- #
# Cluster Configuration
# --------------------------------------------------------------------------- #

datacenter    = "dc1"
nomad_edition = "oss"       # "oss" or "enterprise"
nomad_version = "1.11.3"

# Enterprise license (required when nomad_edition = "enterprise"):
# nomad_enterprise_license_file = "~/licenses/nomad-enterprise.hclic"
# nomad_license_path_on_vm      = "/etc/nomad.d/license.hclic"
# nomad_enterprise_license      = ""  # Or paste license content directly

enable_acl            = true
enable_raw_exec       = true
enable_docker_volumes = true
install_docker        = true
vm_ready_delay        = "30s"
cluster_stabilize_delay = "15s"

# --------------------------------------------------------------------------- #
# Feature Toggles
# --------------------------------------------------------------------------- #

# Phase 1: Set to false, apply to create VMs + cluster
# Phase 2: Set to true, apply to configure Nomad resources
enable_nomad_setup = false

enable_host_volumes = true
enable_oidc         = false

# --------------------------------------------------------------------------- #
# Namespaces
# --------------------------------------------------------------------------- #

namespaces = {
  development = {
    description = "Development environment for testing and experimentation"
    meta        = { environment = "dev", owner = "dev-team" }
  }
  staging = {
    description = "Staging environment for pre-production testing"
    meta        = { environment = "staging", owner = "qa-team" }
  }
  production = {
    description = "Production environment for live workloads"
    meta        = { environment = "prod", owner = "ops-team" }
  }
}

# --------------------------------------------------------------------------- #
# Host Volumes
# --------------------------------------------------------------------------- #

host_volumes = {
  data = {
    path        = "/opt/nomad/volumes/data"
    read_only   = false
    permissions = "777"
  }
  secrets = {
    path        = "/opt/nomad/volumes/secrets"
    read_only   = false
    permissions = "700"
  }
  logs = {
    path        = "/opt/nomad/volumes/logs"
    read_only   = false
    permissions = "755"
  }
}

# --------------------------------------------------------------------------- #
# Jobs — deployed via CLI (not Terraform)
# --------------------------------------------------------------------------- #
# Job specs live in nomad-jobs/ at the repo root.
# Deploy with: ./scripts/deploy-jobs.sh

# --------------------------------------------------------------------------- #
# Secrets (Nomad Variables)
# --------------------------------------------------------------------------- #

nomad_secrets = {
  db_credentials = {
    path      = "secrets/database"
    namespace = "development"
    items = {
      username = "app_user"
      password = "change-me-in-production"
      host     = "db.service.consul"
      port     = "5432"
      database = "myapp"
    }
  }
  api_keys = {
    path      = "secrets/api"
    namespace = "development"
    items = {
      stripe_key   = "sk_test_replace_me"
      sendgrid_key = "SG.replace_me"
    }
  }
}

# --------------------------------------------------------------------------- #
# Custom ACL Policies
# --------------------------------------------------------------------------- #

# custom_acl_policies = {

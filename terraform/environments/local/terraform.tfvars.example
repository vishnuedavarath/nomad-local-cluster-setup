# --------------------------------------------------------------------------- #
# OIDC / Dex
# --------------------------------------------------------------------------- #

# Dex provider configuration
oidc_identity_client_index = 0
oidc_dex_runtime           = "host"   # "host" = Docker on macOS, "vm" = Docker inside Multipass VM
oidc_host_access_ip        = ""       # auto-detected from VM subnet if empty
oidc_dex_image             = "ghcr.io/dexidp/dex:v2.41.1"
oidc_dex_container_name    = "nomad-local-dex"
oidc_dex_http_port         = 5556
oidc_dex_client_id         = "nomad-local"

# Dex admin user credentials
oidc_admin_email         = "nomad-admin@example.com"
oidc_admin_username      = "nomad-admin"
# Generate new hash: htpasswd -nbBC 10 "" "your-password" | cut -d: -f2
oidc_admin_password_hash = "$2y$10$uaHf2Q.dj9C/5y4Olmk/DOEqeuRUibBMk0u50nsKrZ1Ga.3D0HNfS"  # "nomad-admin-password"

# Additional redirect URIs (e.g., for remote access)
oidc_additional_redirect_uris = []

# Nomad ACL auth method configuration
oidc_create_auth_method        = true     # Create nomad_acl_auth_method resource
oidc_auth_method_name          = "local-dex"
oidc_auth_method_max_token_ttl = "8h"
oidc_make_default_auth_method  = true     # Makes this the default for `nomad login`

# Additional OIDC binding rules (beyond the default admin rule)
oidc_binding_rules = {
  # developers = {
  #   description = "Map developers group to developer policy"
  #   selector    = "\"engineering\" in list.groups"
  #   bind_type   = "policy"
  #   bind_name   = "developer"
  # }
  # ops_team = {
  #   description = "Map ops group to ops policy"
  #   selector    = "\"ops\" in list.groups"
  #   bind_type   = "policy"
  #   bind_name   = "ops"
  # }
}
